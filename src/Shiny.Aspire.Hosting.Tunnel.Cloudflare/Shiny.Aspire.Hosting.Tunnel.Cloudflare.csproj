<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Shiny.Aspire.Hosting.Tunnel.Cloudflare</RootNamespace>
        <Description>Cloudflare Tunnel for Aspire. Runs cloudflared as a container beside the app and publishes a project or container endpoint through it - a throwaway trycloudflare.com address, or a named tunnel on your own domain.</Description>
        <PackageTags>aspire tunnel cloudflare cloudflared webhook shiny</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.Aspire.Hosting.Tunnel.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Shiny.Aspire.Hosting.Tunnel/Shiny.Aspire.Hosting.Tunnel.csproj"/>
    </ItemGroup>

</Project>
