<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Shiny.Aspire.Hosting.Tunnel.AzureRelay</RootNamespace>
        <Description>Azure Relay Hybrid Connections tunnelling for Aspire. Gives a project or container endpoint a stable public HTTPS address with no inbound connectivity and no port forwarding.</Description>
        <PackageTags>aspire tunnel azure relay hybridconnections webhook shiny</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.Aspire.Hosting.Tunnel.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Shiny.Net.HttpServer.AzureRelay"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Shiny.Aspire.Hosting.Tunnel/Shiny.Aspire.Hosting.Tunnel.csproj"/>
    </ItemGroup>

</Project>
