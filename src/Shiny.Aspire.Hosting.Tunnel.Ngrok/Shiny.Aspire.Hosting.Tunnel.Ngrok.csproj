<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Shiny.Aspire.Hosting.Tunnel.Ngrok</RootNamespace>
        <Description>ngrok for Aspire. Runs the ngrok agent as a container beside the app and publishes a project or container endpoint through it, with the assigned address surfaced as a connection string.</Description>
        <PackageTags>aspire tunnel ngrok webhook shiny</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.Aspire.Hosting.Tunnel.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Shiny.Aspire.Hosting.Tunnel/Shiny.Aspire.Hosting.Tunnel.csproj"/>
    </ItemGroup>

</Project>
