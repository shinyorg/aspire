<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Shiny.Aspire.Hosting.Tunnel</RootNamespace>
        <Description>Public addresses for Aspire resources. A pluggable tunnel resource with the Shiny relay built in - host the relay in the app model and publish any project or container endpoint through it.</Description>
        <PackageTags>aspire tunnel relay ngrok webhook shiny</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.Aspire.Hosting.Tunnel.Ssh"/>
        <InternalsVisibleTo Include="Shiny.Aspire.Hosting.Tunnel.AzureRelay"/>
        <InternalsVisibleTo Include="Shiny.Aspire.Hosting.Tunnel.Cloudflare"/>
        <InternalsVisibleTo Include="Shiny.Aspire.Hosting.Tunnel.Ngrok"/>
        <InternalsVisibleTo Include="Shiny.Aspire.Hosting.Tunnel.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting"/>
        <PackageReference Include="Shiny.Net.HttpServer"/>
    </ItemGroup>

</Project>
